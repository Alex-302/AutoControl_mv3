{
"update_url": "https://clients2.google.com/service/update2/crx",

"name": "TOOLBAR BUTTON: Pin",

"version": "3",
"manifest_version": 3,

"description": "Pin/unpin the current tab with a single click.",

"minimum_chrome_version": "88",

"background": {"service_worker": "bgPage.js"},

"action": {
	"default_icon": {
		"16": "logo16.png",
		"32": "logo32.png",
		"48": "logo48.png"
	}
},

"icons": {
	"16": "logo16.png",
	"32": "logo32.png",
	"48": "logo48.png",
	"128": "logo128.png"
},

"permissions": ["tabs"],

"offline_enabled": true,

"key": ""

}
